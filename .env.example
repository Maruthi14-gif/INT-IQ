# Copy to .env.local, or run `neon env pull` to fill the Neon values for you.

# Neon Postgres: pooled URL for the app, direct URL for migrations (npm run db:migrate)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon Auth
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.REGION.aws.neon.tech/neondb/auth"
# Session cookie secret (32+ characters). Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""

# AI interviewer: free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Voice interviews (Vapi): public key from https://dashboard.vapi.ai -> API Keys.
# Used only on the server. In Vapi, allow your site origin and don't restrict it to specific assistants
# (each interview creates its own assistant).
VAPI_PUBLIC_KEY=""
# Optional saved assistant to use as the base configuration. INT-IQ applies
# interview-specific model, first-message, voice, and metadata overrides per call.
VAPI_ASSISTANT_ID=""
# Optional
# VAPI_VOICE_ID="Clara"              # overrides the saved assistant's voice when set
# VAPI_LOCAL_MODEL_ID="gpt-4.1"      # saved-assistant model used only for localhost voice calls
# VAPI_LLM_BASE_URL="https://..."    # public URL Vapi uses to reach this app (needed for local dev via a tunnel)
# VAPI_LLM_SECRET="..."              # signs voice-agent requests (defaults to NEON_AUTH_COOKIE_SECRET)
